generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") 
}

model Evento {
  id            Int      @id @default(autoincrement())
  titulo        String
  descricao     String?  @db.Text
  dataEvento    DateTime
  imagemUrl     String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
}